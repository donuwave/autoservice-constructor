---
import Icon from './Icon.astro';
import { type Client, telHref } from '../lib/client';

interface Props {
  client: Client;
}
const { client } = Astro.props;
const success =
  client.booking?.successText ?? 'Перезвоним в рабочее время, чтобы подтвердить запись.';
const whenOptions = ['Сегодня', 'Завтра', 'На этой неделе', 'Не срочно'];
---

<section class="section" id="booking" aria-labelledby="booking-title">
  <div class="wrap grid">
    <div class="intro">
      <h2 id="booking-title">Запись на ремонт</h2>
      <p>
        Опишите, что с машиной, и оставьте телефон. Перезвоним, уточним детали и предложим время.
      </p>
      <p class="call">
        Быстрее по телефону:
        <a href={telHref(client.phone)}>{client.phone}</a>
      </p>
    </div>

    <div class="card">
      <form data-booking novalidate>
        <input type="hidden" name="slug" value={client.slug} />
        <div class="hp" aria-hidden="true">
          <label>Компания <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="row">
          <label class="field">
            <span>Имя</span>
            <input name="name" type="text" autocomplete="given-name" maxlength="80" />
          </label>
          <label class="field">
            <span>Телефон <em>обязательно</em></span>
            <input
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="+7"
              maxlength="30"
              required
              aria-describedby="phone-error"
            />
            <small class="error" id="phone-error" hidden>Укажите номер, чтобы мы могли перезвонить</small>
          </label>
        </div>

        <label class="field">
          <span>Марка и модель</span>
          <input name="car" type="text" placeholder="Например, Kia Rio 2017" maxlength="80" />
        </label>

        <label class="field">
          <span>Что случилось</span>
          <textarea
            name="problem"
            rows="3"
            maxlength="1000"
            placeholder="Стучит спереди на кочках, нужен развал, пора менять масло"></textarea>
        </label>

        <fieldset class="field">
          <legend>Когда удобно приехать</legend>
          <div class="chips">
            {
              whenOptions.map((opt, i) => (
                <label class="chip">
                  <input type="radio" name="when" value={opt} checked={i === 0} />
                  <span>{opt}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <button class="btn btn-primary submit" type="submit">Отправить заявку</button>
        <p class="form-error" role="alert" hidden>
          Заявка не отправилась. Позвоните нам: <a href={telHref(client.phone)}>{client.phone}</a>
        </p>
        <p class="consent">Нажимая кнопку, вы соглашаетесь на обработку телефона и имени для связи по заявке.</p>
      </form>

      <div class="done" data-booking-done hidden tabindex="-1">
        <span class="done-icon"><Icon name="check" /></span>
        <h3>Заявка отправлена</h3>
        <p>{success}</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((form) => {
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const phoneError = form.querySelector<HTMLElement>('#phone-error')!;
    const formError = form.querySelector<HTMLElement>('.form-error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const done = form.parentElement!.querySelector<HTMLElement>('[data-booking-done]')!;

    const phoneOk = () => phone.value.replace(/\D/g, '').length >= 10;

    phone.addEventListener('input', () => {
      if (phoneOk()) {
        phoneError.hidden = true;
        phone.removeAttribute('aria-invalid');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;

      if (!phoneOk()) {
        phoneError.hidden = false;
        phone.setAttribute('aria-invalid', 'true');
        phone.focus();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      button.disabled = true;
      button.textContent = 'Отправляем…';

      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        formError.hidden = false;
        button.disabled = false;
        button.textContent = 'Отправить заявку';
      }
    });
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: start;
  }

  .intro p {
    margin-top: 16px;
    color: var(--muted);
    max-width: 40ch;
  }

  .intro .call {
    color: var(--ink);
  }

  .call a {
    font-weight: 600;
    white-space: nowrap;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }

  form {
    display: grid;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .field > span,
  legend {
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0;
  }

  legend {
    margin-bottom: 8px;
  }

  .field em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
    margin-left: 4px;
  }

  input[type='text'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #b9c1cb;
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }

  input[aria-invalid='true'] {
    border-color: var(--closed);
  }

  .error {
    color: var(--closed);
    font-size: 0.875rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid #b9c1cb;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .chip input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .submit {
    width: 100%;
    margin-top: 4px;
  }

  .form-error {
    color: var(--closed);
  }

  .consent {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .done {
    text-align: center;
    padding: 32px 8px;
  }

  .done:focus {
    outline: none;
  }

  .done-icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ok) 14%, white);
    color: var(--ok);
  }

  .done-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .done h3 {
    margin-top: 16px;
    font-size: 1.4rem;
  }

  .done p {
    margin: 8px auto 0;
    max-width: 36ch;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 20px 16px;
    }
  }
</style>
