---
import Icon from './Icon.astro';
import { type Client, telHref } from '../lib/client';

interface Props {
  client: Client;
}
const { client } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <p>
      <strong>{client.name}</strong>, автосервис<br />
      <span>{client.address}{client.city && `, ${client.city}`}</span>
    </p>
    <p class="right">
      <a href={telHref(client.phone)}>{client.phone}</a><br />
      <span>© {year}</span>
    </p>
  </div>
</footer>

<!-- Панель с кнопками внизу экрана на телефоне -->
<nav class="mobile-bar" aria-label="Быстрые действия">
  <a class="btn btn-primary" href={telHref(client.phone)}><Icon name="phone" />Позвонить</a>
  <a class="btn btn-secondary" href="#booking"><Icon name="calendar" />Записаться</a>
</nav>

<style>
  .footer {
    padding: 36px 0;
    background: var(--ink);
    color: #fff;
    font-size: 0.9375rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
  }

  .footer span {
    color: rgb(255 255 255 / 0.65);
  }

  .footer a {
    color: #fff;
    font-weight: 600;
  }

  .right {
    text-align: right;
  }

  .mobile-bar {
    display: none;
  }

  @media (max-width: 640px) {
    .footer {
      padding-bottom: 104px;
    }

    .right {
      text-align: left;
    }

    .mobile-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 10;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 0.96);
      border-top: 1px solid var(--line);
      box-shadow: 0 -6px 18px rgb(20 30 45 / 0.08);
    }

    .mobile-bar .btn {
      min-height: 48px;
      padding: 0 12px;
    }
  }
</style>
