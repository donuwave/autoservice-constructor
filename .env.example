# Какого клиента показывать на главной странице (имя файла из clients/ без .json).
# Если не задано, на главной будет список всех демо (закрыт от поисковиков).
CLIENT=

# Бот, который присылает заявки. Создать: @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=

# Куда слать заявки, если у клиента в конфиге не указан booking.telegramChatId.
# Для демо удобно указать свой chat id: заявки от владельцев придут тебе.
TELEGRAM_CHAT_ID=

# Адрес сайта, нужен для canonical и разметки (например https://time-service52.ru)
SITE_URL=

# Порт сервера после сборки (npm start)
PORT=3000

# Публиковать только этих клиентов через запятую (slug из clients/). Пусто — все.
CLIENTS=
